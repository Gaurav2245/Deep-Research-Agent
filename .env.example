# Copy this file to .env and fill in your own values.
# Required
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
TAVILY_API_KEY=

# Optional — LLM / Azure OpenAI
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional — research behavior
SEARCH_PROVIDER=tavily
LLM_PROVIDER=azure_openai
ENABLE_SCRAPER=true
SCRAPER_MAX_URLS=3
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
RESEARCH_DEPTH=deep
MAX_SEARCH_ITERATIONS=3
MAX_RESULTS_PER_SEARCH=5
ENABLE_FOLLOW_UP_SEARCHES=true
# Auto-routes Indian stock-market queries (nifty/sensex/gainers/losers/banknifty)
# to the live NSE data tool instead of generic web search. Set to false to disable.
ENABLE_NSE_AUTO_ROUTING=true

# Optional — NSE India data source
NSE_TIMEOUT=20
NSE_MAX_RETRIES=3
NSE_HEADLESS=true

# Optional — database (defaults match docker-compose.yml)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deep_research_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional — Streamlit UI
# Shows a raw internal-state JSON panel on the research report. Off by default
# since it's not meant for end users.
SHOW_DEBUG_PANEL=false

# Optional — API
# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
# If set, all /api/v1/* requests must send this value in the X-API-Key header.
# Leave unset for local development (no auth enforced).
API_KEY=
# Per-client-IP rate limit (in-memory, single-instance only). Set
# RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Optional — Streamlit UI: where the API lives.
# Default (http://localhost:8000/api/v1) matches `uvicorn api.main:app` run locally.
# Use http://localhost:8080/api/v1 instead if you're running the docker-compose stack.
API_BASE_URL=http://localhost:8000/api/v1

# Optional — observability
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deep-research-agent
